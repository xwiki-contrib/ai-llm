{
  // The settings the xwiki-contrib repositories share. See https://github.com/xwiki-contrib/.github
  "extends": ["github>xwiki-contrib/.github//renovate/default.json5"],

  "packageRules": [
    // Tink 1.16+ requires protobuf-java 4.x while the XWiki platform manages 3.25.x (re-check when the parent version changes)
    {
      "matchPackageNames": ["com.google.crypto.tink:tink"],
      "allowedVersions": "<=1.15.0"
    }
  ]
}
